VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN sample_design ;
UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 10000 10000 ) ;

COMPONENTS 16 ;
- comp1 NAND2 + PLACED ( 1000 1000 ) N ;
- comp2 NOR2 + PLACED ( 3000 1000 ) N ;
- comp3 INV + PLACED ( 5000 1000 ) N ;
- comp4 BUF + PLACED ( 7000 1000 ) N ;
- comp5 AND2 + PLACED ( 1000 3000 ) N ;
- comp6 OR2 + PLACED ( 3000 3000 ) N ;
- comp7 XOR2 + PLACED ( 5000 3000 ) N ;
- comp8 XNOR2 + PLACED ( 7000 3000 ) N ;
- comp9 NAND3 + PLACED ( 1000 5000 ) N ;
- comp10 NOR3 + PLACED ( 3000 5000 ) N ;
- comp11 AND3 + PLACED ( 5000 5000 ) N ;
- comp12 OR3 + PLACED ( 7000 5000 ) N ;
- comp13 MUX2 + PLACED ( 1000 7000 ) N ;
- comp14 DFF + PLACED ( 3000 7000 ) N ;
- comp15 LATCH + PLACED ( 5000 7000 ) N ;
- comp16 TIE + PLACED ( 7000 7000 ) N ;
END COMPONENTS

PINS 8 ;
- in1 + NET in1 + DIRECTION INPUT + FIXED ( 0 2500 ) N ;
- in2 + NET in2 + DIRECTION INPUT + FIXED ( 0 5000 ) N ;
- in3 + NET in3 + DIRECTION INPUT + FIXED ( 0 7500 ) N ;
- clk + NET clk + DIRECTION INPUT + FIXED ( 5000 0 ) N ;
- out1 + NET out1 + DIRECTION OUTPUT + FIXED ( 10000 2500 ) N ;
- out2 + NET out2 + DIRECTION OUTPUT + FIXED ( 10000 5000 ) N ;
- out3 + NET out3 + DIRECTION OUTPUT + FIXED ( 10000 7500 ) N ;
- gnd + NET gnd + DIRECTION INOUT + FIXED ( 5000 10000 ) N ;
END PINS

NETS 12 ;
- in1 ( PIN in1 ) ( comp1 A ) ;
- in2 ( PIN in2 ) ( comp2 A ) ;
- in3 ( PIN in3 ) ( comp3 A ) ;
- clk ( PIN clk ) ( comp14 CLK ) ( comp15 CLK ) ;
- net1 ( comp1 Y ) ( comp5 A ) ;
- net2 ( comp2 Y ) ( comp6 A ) ;
- net3 ( comp3 Y ) ( comp7 A ) ;
- net4 ( comp5 Y ) ( comp9 A ) ;
- net5 ( comp6 Y ) ( comp10 A ) ;
- out1 ( comp9 Y ) ( PIN out1 ) ;
- out2 ( comp10 Y ) ( PIN out2 ) ;
- out3 ( comp14 Q ) ( PIN out3 ) ;
END NETS

END DESIGN
